DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Peradresuoti pasenusį /api/api/* į /api/* (301 Permanent Redirect)
    RewriteRule ^api/api/(.*)$ /api/$1 [R=301,L,QSA]

    # Visus alternatyvius admin kelius (/public/admin, /api/public/admin) nukreipti į vienintelį /api/admin/
    RewriteRule ^(api/)?public/admin(/.*)?$ /api/admin/ [R=301,L,QSA]

    # Nukreipti /api/node/{key} ir /node/{key} į /api/node/index.php failą
    RewriteRule ^api/node/(.+)$ /api/node/index.php?subpath=$1 [L,QSA]
    RewriteRule ^node/(.+)$ /api/node/index.php?subpath=$1 [L,QSA]

    # Jei kreipiamasi tiesiai į /api/node arba /node be identifikatoriaus – iškart mesti 404
    RewriteCond %{QUERY_STRING} !(subpath|public_key|node_id|bot_id|endpoint)
    RewriteRule ^(api/)?node/?$ - [R=404,L]

    RewriteRule ^api/node/?$ /api/node/index.php [L,QSA]
    RewriteRule ^node/?$ /api/node/index.php [L,QSA]

    # Jei failas ar katalogas egzistuoja fiziškai - atidaryti jį
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Nukreipti adverts, raw, telemetry, nodes, repyters, repeaters, repeater į src/app.php
    RewriteRule ^(adverts|raw|telemetry|nodes|repyters|repeaters|repeater|repyter|bots)(\.(php|json))?/?$ src/app.php [L,QSA]
    RewriteRule ^api/(adverts|raw|telemetry|nodes|repyters|repeaters|repeater|repyter|bots)(\.(php|json))?/?$ src/app.php [L,QSA]
</IfModule>
